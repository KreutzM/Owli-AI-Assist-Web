{
  "name": "owli-ai-assist-web",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible progressive web client for Owli-AI Assist.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/build-web.mjs mock",
    "build:staging": "node tools/build-web.mjs staging",
    "build:production": "node tools/build-web.mjs production",
    "build:safari-jpeg-harness": "node tools/build-web.mjs safari-jpeg-harness",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config=playwright.staging.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts tests/e2e/remote-readiness.spec.ts",
    "test:ports": "node tools/check-vite-port-policy.mjs",
    "guardrails": "node tools/check-architecture.mjs",
    "ai:index": "node tools/generate-repo-index.mjs",
    "workflow:check": "node tools/check-workflow-policy.mjs",
    "atomic:publish": "node tools/publish-atomic-git-data.mjs",
    "atomic:publish:test": "node tools/publish-atomic-git-data.test.mjs",
    "check:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm guardrails && pnpm workflow:check && pnpm atomic:publish:test && pnpm test",
    "check:all": "pnpm check:fast && pnpm build && pnpm test:ports && pnpm test:e2e && pnpm test:e2e:staging"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
